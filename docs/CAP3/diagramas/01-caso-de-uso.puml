@startuml caso-de-uso
' Figura 1 - Diagrama de Casos de Uso do sistema VellumMD
' Renderize em https://www.plantuml.com/plantuml ou na extensao PlantUML do VS Code
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #EBF5FB
  BorderColor #1A3A5C
  ArrowColor #2C3E50
}

actor "Usuário" as U
actor "Serviço de IA\nExterno" as IA

rectangle "Sistema VellumMD" {
  usecase "Gerenciar Vault" as UC1
  usecase "Criar e Editar Nota" as UC2
  usecase "Visualizar Backlinks" as UC3
  usecase "Configurar Sistema" as UC4
  usecase "Buscar Notas por\nSignificado" as UC5
  usecase "Consultar Assistente\nde IA" as UC6
  usecase "Aplicar Ação de IA\nno Texto" as UC7
  usecase "Exportar Documento" as UC8
}

U --> UC1
U --> UC2
U --> UC3
U --> UC4
U --> UC5
U --> UC6
U --> UC7
U --> UC8

' O ator secundario (Servico de IA externo) participa dos casos de uso
' que dependem de rede: busca semantica, chat e acoes de IA.
UC5 ..> IA : «usa»
UC6 ..> IA : «usa»
UC7 ..> IA : «usa»

@enduml
